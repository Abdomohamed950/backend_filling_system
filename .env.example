# Server
PORT=3000
SOCKET_PORT=5000

# Database (PostgreSQL) — مستخدم فقط في سكربت النقل scripts/migrate-pg-to-sqlite.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filling_system
DB_USER=postgres
DB_PASSWORD=

# Database (SQLite) — الملف يُنشأ تلقائيًا
SQLITE_PATH=./data/filling_system.db

# MQTT
MQTT_URL=mqtt://localhost:1883

# Auth — التوكن اختياري افتراضيًا؛ AUTH_REQUIRED=true يفرضه على كل المسارات
AUTH_REQUIRED=true
JWT_EXPIRES_IN=12h
# JWT_SECRET=
